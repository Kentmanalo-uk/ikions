{
  "name": "@ikions/react",
  "version": "0.1.0",
  "description": "Typed, tree-shakeable React components for the Ikions icon library (Outline and Filled).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "default": "./dist/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "react",
    "react icons",
    "react components",
    "jsx",
    "icons",
    "icon",
    "icon library",
    "free icons",
    "svg icons",
    "open source icons",
    "outline icons",
    "filled icons",
    "ikions",
    "ui",
    "design system"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "esbuild": "^0.25.0"
  },
  "homepage": "https://www.ikions.cloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kentmanalo-uk/ikions.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Kentmanalo-uk/ikions/issues"
  },
  "author": "Mike Fernandez"
}
