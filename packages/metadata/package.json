{
  "name": "@ikions/metadata",
  "version": "0.2.1",
  "description": "Searchable metadata for the Ikions icon library: names, aliases, tags, categories and a ranked search engine.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "default": "./dist/search.js"
    },
    "./icons.json": "./icons.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "icons.json",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "search",
    "metadata",
    "icons",
    "icon",
    "icon library",
    "free icons",
    "svg icons",
    "outline icons",
    "filled icons",
    "ikions",
    "ui",
    "design system"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "homepage": "https://www.ikions.cloud",
  "author": "Mike Fernandez",
  "publishConfig": {
    "access": "public"
  }
}
