{
  "name": "@ikions/icons",
  "version": "0.1.0",
  "description": "Original Ikions SVG icons in Outline and Filled variants, framework independent.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./outline/*": "./outline/*",
    "./filled/*": "./filled/*",
    "./sprite/*": "./sprite/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "outline",
    "filled",
    "sprite",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "svg",
    "sprite",
    "icons",
    "icon",
    "icon library",
    "free icons",
    "svg icons",
    "open source icons",
    "outline icons",
    "filled icons",
    "ikions",
    "ui",
    "design system"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "homepage": "https://www.ikions.cloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kentmanalo-uk/ikions.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/Kentmanalo-uk/ikions/issues"
  },
  "author": "Mike Fernandez"
}
