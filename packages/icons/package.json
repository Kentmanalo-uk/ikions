{
  "name": "@ikions/icons",
  "version": "0.2.1",
  "description": "Original Ikions SVG icons in Outline and Filled variants, framework independent.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nodes/*": {
      "types": "./dist/generated/icons/*.d.ts",
      "default": "./dist/generated/icons/*.js"
    },
    "./outline/*": "./outline/*",
    "./filled/*": "./filled/*",
    "./sprite/*": "./sprite/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "outline",
    "filled",
    "sprite",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "svg",
    "sprite",
    "icons",
    "icon",
    "icon library",
    "free icons",
    "svg icons",
    "outline icons",
    "filled icons",
    "ikions",
    "ui",
    "design system"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "homepage": "https://www.ikions.cloud",
  "author": "Mike Fernandez",
  "publishConfig": {
    "access": "public"
  }
}
