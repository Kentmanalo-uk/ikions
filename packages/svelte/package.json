{
  "name": "@ikions/svelte",
  "version": "0.2.1",
  "description": "Svelte 5 components for the Ikions icon library (Outline and Filled).",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "svelte": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "svelte": "./src/index.js",
      "default": "./src/index.js"
    },
    "./icons/*": {
      "svelte": "./src/icons/*",
      "default": "./src/icons/*"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "svelte",
    "svelte5",
    "svelte icons",
    "svelte components",
    "icons",
    "icon",
    "icon library",
    "free icons",
    "svg icons",
    "outline icons",
    "filled icons",
    "ikions",
    "ui",
    "design system"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "svelte": "^5.30.0",
    "vitest": "^3.2.7"
  },
  "homepage": "https://www.ikions.cloud",
  "author": "Mike Fernandez",
  "publishConfig": {
    "access": "public"
  }
}
