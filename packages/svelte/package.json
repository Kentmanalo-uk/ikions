{
  "name": "@ikions/svelte",
  "version": "0.1.0",
  "description": "Svelte 5 components for the Ikions icon library (Outline and Filled).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "svelte": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "svelte": "./src/index.js",
      "default": "./src/index.js"
    },
    "./icons/*": {
      "svelte": "./src/icons/*",
      "default": "./src/icons/*"
    },
    "./package.json": "./package.json"
  },
  "files": ["src", "LICENSE", "README.md"],
  "keywords": ["icons", "svelte", "svelte5", "svg", "ikions", "components"],
  "scripts": {
    "test": "vitest run"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "svelte": "^5.30.0",
    "vitest": "^3.2.7"
  }
}
