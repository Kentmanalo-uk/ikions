{
  "name": "@ikions/vue",
  "version": "0.1.0",
  "description": "Vue 3 components for the Ikions icon library (Outline and Filled).",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "default": "./dist/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "vue",
    "vue3",
    "vue icons",
    "vue components",
    "icons",
    "icon",
    "icon library",
    "free icons",
    "svg icons",
    "outline icons",
    "filled icons",
    "ikions",
    "ui",
    "design system"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "vue": "^3.5.0"
  },
  "homepage": "https://www.ikions.cloud",
  "author": "Mike Fernandez"
}
